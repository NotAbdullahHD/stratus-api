{
  "sites": {
    "ghostcloud.ghostos.workers.dev": {
      "name": "GhostCloud Launcher",
      "cap": 20,
      "allowed": true,
      "enabled": true,
      "max_concurrent_sessions": 100,
      "max_session_seconds": 3600,
      "limits": {
        "per_minute": 60,
        "per_hour": 3600,
        "per_day": 86400,
        "per_month": 2592000
      }
    }
  }
}
